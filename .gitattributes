# Windows batch files MUST use CRLF: cmd.exe mis-parses multi-line parenthesized
# blocks (IF/FOR) when the file is LF-only. Force CRLF regardless of the editing OS.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts + macOS .command MUST use LF: a CR (\r) in the shebang breaks the
# interpreter on macOS/Linux ("bad interpreter: /bin/bash^M"). Force LF.
*.sh text eol=lf
*.command text eol=lf

# Data a test reproduces byte for byte from its generator: a Windows checkout with autocrlf
# would turn it into CRLF and the comparison would fail there only. Pinned to LF on every
# checkout; tests/test_byte_pinned_files_keep_lf.py refuses a new byte-pinned file without
# such a rule.
vaf/auth/data/*.txt text eol=lf
